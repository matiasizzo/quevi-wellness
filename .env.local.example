# ─── Supabase ────────────────────────────────────────────────────────────────
# Obtener en: https://supabase.com/dashboard/project/<ID>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_ID>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY>

# Solo para server-side (API routes, webhooks) — nunca exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

# ─── Stripe ──────────────────────────────────────────────────────────────────
# QUEVI Stripe account
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://queviwellnessclinic.es

# ─── Google Analytics 4 + Google Ads ─────────────────────────────────────────
# Sin estas dos, no se carga ninguna etiqueta de Google (útil en desarrollo).
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX

# Etiquetas de conversión. Se copian de Google Ads → Objetivos → Conversiones →
# la conversión → "Configurar etiqueta", con el formato completo AW-XXXX/YYYY.
# Conversión PRINCIPAL: solicitud de cita desde la landing
NEXT_PUBLIC_GADS_CONV_LEAD=AW-XXXXXXXXXX/XXXXXXXXXXXXXXXXXXX
# Secundarias (se miden, no se optimiza hacia ellas)
NEXT_PUBLIC_GADS_CONV_WHATSAPP=
NEXT_PUBLIC_GADS_CONV_PHONE=
NEXT_PUBLIC_GADS_CONV_PURCHASE=

# ─── WhatsApp (botón flotante y landings) ────────────────────────────────────
# Formato internacional, solo dígitos
NEXT_PUBLIC_WHATSAPP_NUMBER=34683462705

# ─── Microsoft Clarity (analítica: mapas de calor + grabaciones) ─────────────
# ID del proyecto en https://clarity.microsoft.com (Settings → Setup)
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ─── Admin dashboard ─────────────────────────────────────────────────────────
# Contraseña para acceder a /admin — pon una contraseña fuerte
ADMIN_PASSWORD=cambia_esto_por_una_contraseña_segura

# ─── Resend (emails transaccionales de pedidos) ──────────────────────────────
# API key en https://resend.com/api-keys
RESEND_API_KEY=re_...
# Remitente — el dominio debe estar verificado en Resend (o usa onboarding@resend.dev para pruebas)
RESEND_FROM_EMAIL=QUEVI Wellness Clinic <pedidos@queviwellnessclinic.es>
# Email de la clínica que recibe el aviso de cada pedido nuevo
ORDER_NOTIFICATIONS_EMAIL=info@quevi.com
